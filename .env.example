DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/fleet_os?sslmode=require"
AUTH_SECRET="replace-with-at-least-32-random-characters"
# Only required while running `npm run db:seed`; do not expose it to the browser.
SEED_ADMIN_PASSWORD="replace-before-running-the-production-seed"
STORAGE_PROVIDER="vercel-blob"
BLOB_READ_WRITE_TOKEN=""
NEXT_PUBLIC_MAP_PROVIDER="fallback"
