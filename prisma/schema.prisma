generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}
enum BookingStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  CONFIRMED
  DRIVER_ASSIGNED
  VEHICLE_ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  PASSENGER_ONBOARD
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}
enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}
enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum LocationType {
  CITY
  AIRPORT
  DESTINATION
  ATTRACTION
  PICKUP_ZONE
  SERVICE_ZONE
}
enum DiscountType {
  PERCENTAGE
  FIXED
}
enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  name String
  status UserStatus @default(ACTIVE)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  roles UserRole[]
  customer CustomerProfile?
  createdAudit AuditLog[] @relation("AuditActor")
  bookings Booking[]
  favorites Favorite[]
  reviews Review[]
  tickets SupportTicket[]
}
model Role {
  id String @id @default(cuid())
  name String @unique
  description String?
  isSystem Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users UserRole[]
  permissions RolePermission[]
}
model Permission {
  id String @id @default(cuid())
  key String @unique
  description String?
  roles RolePermission[]
}
model UserRole {
  userId String
  roleId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  @@id([userId,roleId])
}
model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields:[roleId],references:[id],onDelete:Cascade)
  permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade)
  @@id([roleId,permissionId])
}
model CustomerProfile {
  id String @id @default(cuid())
  userId String @unique
  phone String?
  country String?
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  addresses CustomerAddress[]
  savedPlaces SavedPlace[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model CustomerAddress {
  id String @id @default(cuid())
  customerId String
  label String
  address String
  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  customer CustomerProfile @relation(fields:[customerId],references:[id],onDelete:Cascade)
}
model SavedPlace {
  id String @id @default(cuid())
  customerId String
  name String
  address String
  latitude Decimal? @db.Decimal(10,7)
  longitude Decimal? @db.Decimal(10,7)
  customer CustomerProfile @relation(fields:[customerId],references:[id],onDelete:Cascade)
}

model ServiceCategory {
  id String @id @default(cuid())
  name String
  slug String @unique
  displayOrder Int @default(0)
  isActive Boolean @default(true)
  services Service[]
}
model Service {
  id String @id @default(cuid())
  categoryId String?
  title String
  slug String @unique
  icon String?
  imageUrl String?
  description String?
  isActive Boolean @default(true)
  showOnHomepage Boolean @default(true)
  displayOrder Int @default(0)
  bookingFields Json?
  pricingConfig Json?
  category ServiceCategory? @relation(fields:[categoryId],references:[id])
  settings ServiceSetting[]
  bookings Booking[]
  pricingRules PricingRule[]
  routes Route[]
  promotions PromotionService[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  @@index([isActive,showOnHomepage,displayOrder])
}
model ServiceSetting {
  id String @id @default(cuid())
  serviceId String
  key String
  value Json
  service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade)
  @@unique([serviceId,key])
}

model VehicleCategory {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  displayOrder Int @default(0)
  isActive Boolean @default(true)
  deletedAt DateTime?
  vehicles Vehicle[]
  pricingRules PricingRule[]
}
model VehicleClass {
  id String @id @default(cuid())
  name String
  slug String @unique
  multiplier Decimal @default(1) @db.Decimal(8,2)
  vehicles Vehicle[]
}
model Vehicle {
  id String @id @default(cuid())
  categoryId String
  classId String?
  name String
  slug String @unique
  fleetNumber String @unique
  make String?
  model String?
  year Int?
  passengerCapacity Int
  luggageCapacity Int
  doors Int?
  transmission String?
  fuelType String?
  baseFare Decimal @db.Decimal(12,2)
  perKmRate Decimal @db.Decimal(12,2)
  hourlyRate Decimal @db.Decimal(12,2)
  dailyRate Decimal @db.Decimal(12,2)
  airportEligible Boolean @default(true)
  rentalEligible Boolean @default(false)
  chauffeurEligible Boolean @default(true)
  groupEligible Boolean @default(false)
  isAvailable Boolean @default(true)
  isFeatured Boolean @default(false)
  isPublished Boolean @default(true)
  displayOrder Int @default(0)
  category VehicleCategory @relation(fields:[categoryId],references:[id])
  vehicleClass VehicleClass? @relation(fields:[classId],references:[id])
  features VehicleFeature[]
  images VehicleImage[]
  availability VehicleAvailability[]
  maintenance VehicleMaintenance[]
  bookingVehicles BookingVehicle[]
  pricingRules PricingRule[]
  promotionVehicles PromotionVehicle[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  @@index([isPublished,isAvailable,isFeatured,displayOrder])
}
model VehicleFeature {
  id String @id @default(cuid())
  vehicleId String
  name String
  icon String?
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade)
}
model VehicleImage {
  id String @id @default(cuid())
  vehicleId String
  mediaId String?
  url String
  altText String?
  displayOrder Int @default(0)
  isPrimary Boolean @default(false)
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade)
  media MediaAsset? @relation(fields:[mediaId],references:[id])
}
model VehicleAvailability {
  id String @id @default(cuid())
  vehicleId String
  startsAt DateTime
  endsAt DateTime
  isAvailable Boolean @default(true)
  reason String?
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade)
  @@index([vehicleId,startsAt,endsAt])
}
model VehicleMaintenance {
  id String @id @default(cuid())
  vehicleId String
  startsAt DateTime
  endsAt DateTime?
  type String
  notes String?
  cost Decimal? @db.Decimal(12,2)
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade)
}
model Driver {
  id String @id @default(cuid())
  name String
  phone String
  email String?
  licenseNumber String @unique
  isActive Boolean @default(true)
  photoUrl String?
  availabilities DriverAvailability[]
  bookings Booking[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model DriverAvailability {
  id String @id @default(cuid())
  driverId String
  startsAt DateTime
  endsAt DateTime
  isAvailable Boolean @default(true)
  driver Driver @relation(fields:[driverId],references:[id],onDelete:Cascade)
}

model City {
  id String @id @default(cuid())
  name String
  slug String @unique
  region String?
  isActive Boolean @default(true)
  locations Location[]
  airports Airport[]
  destinations Destination[]
  attractions Attraction[]
}
model Location {
  id String @id @default(cuid())
  cityId String?
  name String
  slug String @unique
  type LocationType
  address String?
  latitude Decimal @db.Decimal(10,7)
  longitude Decimal @db.Decimal(10,7)
  imageUrl String?
  isActive Boolean @default(true)
  isFeatured Boolean @default(false)
  city City? @relation(fields:[cityId],references:[id])
  originRoutes Route[] @relation("RouteOrigin")
  destinationRoutes Route[] @relation("RouteDestination")
  pickupBookings Booking[] @relation("BookingPickup")
  destinationBookings Booking[] @relation("BookingDestination")
  routeStops RouteStop[]
  @@index([type,isActive,isFeatured])
}
model Airport {
  id String @id @default(cuid())
  cityId String
  code String @unique
  name String
  terminalInfo String?
  city City @relation(fields:[cityId],references:[id])
}
model Destination {
  id String @id @default(cuid())
  cityId String
  name String
  slug String @unique
  description String?
  imageUrl String?
  isActive Boolean @default(true)
  isFeatured Boolean @default(false)
  city City @relation(fields:[cityId],references:[id])
}
model Attraction {
  id String @id @default(cuid())
  cityId String
  name String
  slug String @unique
  description String?
  imageUrl String?
  isActive Boolean @default(true)
  city City @relation(fields:[cityId],references:[id])
}
model Route {
  id String @id @default(cuid())
  serviceId String
  originId String
  destinationId String
  slug String @unique
  durationMinutes Int
  distanceKm Decimal @db.Decimal(10,2)
  startingPrice Decimal @db.Decimal(12,2)
  imageUrl String?
  isFeatured Boolean @default(false)
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  service Service @relation(fields:[serviceId],references:[id])
  origin Location @relation("RouteOrigin",fields:[originId],references:[id])
  destination Location @relation("RouteDestination",fields:[destinationId],references:[id])
  stops RouteStop[]
  pricing RoutePricing[]
  bookings Booking[]
  @@index([isActive,isFeatured,displayOrder])
}
model RouteStop {
  id String @id @default(cuid())
  routeId String
  locationId String
  name String
  displayOrder Int
  route Route @relation(fields:[routeId],references:[id],onDelete:Cascade)
  location Location @relation(fields:[locationId],references:[id])
}
model RoutePricing {
  id String @id @default(cuid())
  routeId String
  vehicleCategoryId String?
  basePrice Decimal @db.Decimal(12,2)
  route Route @relation(fields:[routeId],references:[id],onDelete:Cascade)
  @@index([routeId,vehicleCategoryId])
}

model PricingZone {
  id String @id @default(cuid())
  name String
  geoJson Json
  isActive Boolean @default(true)
  rules PricingRule[]
}
model PricingRule {
  id String @id @default(cuid())
  name String
  serviceId String?
  vehicleId String?
  vehicleCategoryId String?
  zoneId String?
  baseFare Decimal? @db.Decimal(12,2)
  perKm Decimal? @db.Decimal(12,2)
  perMinute Decimal? @db.Decimal(12,2)
  hourly Decimal? @db.Decimal(12,2)
  daily Decimal? @db.Decimal(12,2)
  multiplier Decimal? @db.Decimal(8,2)
  startsAt DateTime?
  endsAt DateTime?
  priority Int @default(0)
  isActive Boolean @default(true)
  service Service? @relation(fields:[serviceId],references:[id])
  vehicle Vehicle? @relation(fields:[vehicleId],references:[id])
  vehicleCategory VehicleCategory? @relation(fields:[vehicleCategoryId],references:[id])
  zone PricingZone? @relation(fields:[zoneId],references:[id])
  surcharges Surcharge[]
  @@index([isActive,priority])
}
model Surcharge {
  id String @id @default(cuid())
  pricingRuleId String?
  name String
  type String
  amount Decimal @db.Decimal(12,2)
  conditions Json?
  isActive Boolean @default(true)
  pricingRule PricingRule? @relation(fields:[pricingRuleId],references:[id])
}
model Extra {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String?
  price Decimal @db.Decimal(12,2)
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  bookings BookingExtra[]
}
model Promotion {
  id String @id @default(cuid())
  title String
  description String?
  discountType DiscountType
  discountValue Decimal @db.Decimal(12,2)
  minimumBooking Decimal? @db.Decimal(12,2)
  maximumDiscount Decimal? @db.Decimal(12,2)
  startsAt DateTime
  endsAt DateTime
  usageLimit Int?
  perUserLimit Int?
  isActive Boolean @default(true)
  coupons Coupon[]
  services PromotionService[]
  vehicles PromotionVehicle[]
}
model Coupon {
  id String @id @default(cuid())
  promotionId String
  code String @unique
  usageCount Int @default(0)
  promotion Promotion @relation(fields:[promotionId],references:[id],onDelete:Cascade)
}
model PromotionService {
  promotionId String
  serviceId String
  promotion Promotion @relation(fields:[promotionId],references:[id],onDelete:Cascade)
  service Service @relation(fields:[serviceId],references:[id],onDelete:Cascade)
  @@id([promotionId,serviceId])
}
model PromotionVehicle {
  promotionId String
  vehicleId String
  promotion Promotion @relation(fields:[promotionId],references:[id],onDelete:Cascade)
  vehicle Vehicle @relation(fields:[vehicleId],references:[id],onDelete:Cascade)
  @@id([promotionId,vehicleId])
}

model Booking {
  id String @id @default(cuid())
  reference String @unique
  userId String?
  serviceId String
  routeId String?
  pickupId String
  destinationId String?
  driverId String?
  scheduledAt DateTime
  passengerCount Int
  luggageCount Int
  status BookingStatus @default(PENDING)
  flightNumber String?
  customerNotes String?
  internalNotes String?
  priceSnapshot Json
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @default(0) @db.Decimal(12,2)
  tax Decimal @default(0) @db.Decimal(12,2)
  fees Decimal @default(0) @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  currency String @default("TWD")
  user User? @relation(fields:[userId],references:[id])
  service Service @relation(fields:[serviceId],references:[id])
  route Route? @relation(fields:[routeId],references:[id])
  pickup Location @relation("BookingPickup",fields:[pickupId],references:[id])
  destination Location? @relation("BookingDestination",fields:[destinationId],references:[id])
  driver Driver? @relation(fields:[driverId],references:[id])
  passengers BookingPassenger[]
  vehicles BookingVehicle[]
  extras BookingExtra[]
  history BookingStatusHistory[]
  payments Payment[]
  order Order?
  review Review?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cancelledAt DateTime?
  @@index([status,scheduledAt])
  @@index([userId,createdAt])
}
model BookingPassenger {
  id String @id @default(cuid())
  bookingId String
  firstName String
  lastName String
  type String
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade)
}
model BookingVehicle {
  id String @id @default(cuid())
  bookingId String
  vehicleId String
  price Decimal @db.Decimal(12,2)
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade)
  vehicle Vehicle @relation(fields:[vehicleId],references:[id])
}
model BookingExtra {
  bookingId String
  extraId String
  quantity Int @default(1)
  unitPrice Decimal @db.Decimal(12,2)
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade)
  extra Extra @relation(fields:[extraId],references:[id])
  @@id([bookingId,extraId])
}
model BookingStatusHistory {
  id String @id @default(cuid())
  bookingId String
  fromStatus BookingStatus?
  toStatus BookingStatus
  notes String?
  changedById String?
  createdAt DateTime @default(now())
  booking Booking @relation(fields:[bookingId],references:[id],onDelete:Cascade)
  @@index([bookingId,createdAt])
}
model Order {
  id String @id @default(cuid())
  orderNumber String @unique
  bookingId String @unique
  subtotal Decimal @db.Decimal(12,2)
  discount Decimal @db.Decimal(12,2)
  tax Decimal @db.Decimal(12,2)
  fees Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  currency String @default("TWD")
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus String
  booking Booking @relation(fields:[bookingId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model Payment {
  id String @id @default(cuid())
  bookingId String
  amount Decimal @db.Decimal(12,2)
  currency String @default("TWD")
  provider String
  status PaymentStatus @default(PENDING)
  providerReference String?
  safeMetadata Json?
  booking Booking @relation(fields:[bookingId],references:[id])
  transactions PaymentTransaction[]
  refunds Refund[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model PaymentTransaction {
  id String @id @default(cuid())
  paymentId String
  type String
  amount Decimal @db.Decimal(12,2)
  providerReference String?
  metadata Json?
  payment Payment @relation(fields:[paymentId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
}
model Refund {
  id String @id @default(cuid())
  paymentId String
  amount Decimal @db.Decimal(12,2)
  reason String
  status String
  payment Payment @relation(fields:[paymentId],references:[id])
  createdAt DateTime @default(now())
}

model Favorite {
  id String @id @default(cuid())
  userId String
  entityType String
  entityId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  createdAt DateTime @default(now())
  @@unique([userId,entityType,entityId])
}
model Review {
  id String @id @default(cuid())
  userId String
  bookingId String @unique
  rating Int
  title String?
  content String
  status PublishStatus @default(DRAFT)
  isFeatured Boolean @default(false)
  user User @relation(fields:[userId],references:[id])
  booking Booking @relation(fields:[bookingId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HeroSlide {
  id String @id @default(cuid())
  title String
  highlightedText String?
  subtitle String?
  desktopImage String
  mobileImage String?
  ctaText String?
  ctaUrl String?
  overlay String?
  textAlignment String @default("left")
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  startsAt DateTime?
  endsAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
model HomepageSection {
  id String @id @default(cuid())
  key String @unique
  title String
  subtitle String?
  content String?
  background String?
  imageUrl String?
  ctaText String?
  ctaUrl String?
  layout String?
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  publishAt DateTime?
  unpublishAt DateTime?
  items HomepageSectionItem[]
  updatedAt DateTime @updatedAt
}
model HomepageSectionItem {
  id String @id @default(cuid())
  sectionId String
  title String
  subtitle String?
  content String?
  imageUrl String?
  icon String?
  ctaText String?
  ctaUrl String?
  metadata Json?
  isActive Boolean @default(true)
  displayOrder Int @default(0)
  section HomepageSection @relation(fields:[sectionId],references:[id],onDelete:Cascade)
}
model NavigationItem {
  id String @id @default(cuid())
  label String
  url String
  icon String?
  parentId String?
  location String @default("header")
  isActive Boolean @default(true)
  displayOrder Int @default(0)
}
model Banner {
  id String @id @default(cuid())
  title String
  imageUrl String?
  ctaUrl String?
  placement String
  isActive Boolean @default(true)
  startsAt DateTime?
  endsAt DateTime?
}
model PromotionBanner {
  id String @id @default(cuid())
  promotionId String?
  title String
  imageUrl String?
  isActive Boolean @default(true)
}
model MediaAsset {
  id String @id @default(cuid())
  storageKey String @unique
  url String
  mimeType String
  size Int
  width Int?
  height Int?
  title String?
  altText String?
  createdById String?
  createdAt DateTime @default(now())
  vehicleImages VehicleImage[]
}
model SiteSetting {
  id String @id @default(cuid())
  key String @unique
  value Json
  isPublic Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model SEOSetting {
  id String @id @default(cuid())
  path String @unique
  title String
  description String?
  imageUrl String?
  noIndex Boolean @default(false)
  updatedAt DateTime @updatedAt
}
model Notification {
  id String @id @default(cuid())
  userId String?
  channel String
  type String
  title String
  body String
  status String @default("pending")
  metadata Json?
  sentAt DateTime?
  createdAt DateTime @default(now())
}
model NotificationTemplate {
  id String @id @default(cuid())
  key String @unique
  channel String
  subject String?
  body String
  isActive Boolean @default(true)
  updatedAt DateTime @updatedAt
}
model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entity String
  entityId String?
  oldValue Json?
  newValue Json?
  ipAddress String?
  createdAt DateTime @default(now())
  actor User? @relation("AuditActor",fields:[actorId],references:[id])
  @@index([entity,entityId,createdAt])
}
model SupportTicket {
  id String @id @default(cuid())
  reference String @unique
  userId String?
  subject String
  description String
  status TicketStatus @default(OPEN)
  priority String @default("normal")
  assignedToId String?
  user User? @relation(fields:[userId],references:[id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
